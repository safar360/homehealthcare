# Copy to admin/.env.local. Vite reads env files from the app root, so the ops
# portal needs its own copy -- the one at the repo root only reaches src/.
#
# VITE_SUPABASE_URL must be the bare project URL, with no /rest/v1 suffix.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Phase 2 screens, off unless set to "on". Switch them on one at a time.
# In CI these come from repository variables of the same name.
VITE_FEATURE_PATIENTS=off
VITE_FEATURE_DAY_SHEET=off
VITE_FEATURE_MONTHLY_BILLS=off
